// ═══════════════════════════════════════════════════════════════
// 📝 Blog Management (إدارة المدونة)
// ═══════════════════════════════════════════════════════════════

model Blog {
  id              String   @id @default(cuid())
  titleEn         String
  titleAr         String
  slug            String   @unique
  excerptEn       String   @db.Text
  excerptAr       String   @db.Text
  contentEn       String   @db.Text
  contentAr       String   @db.Text
  coverImage      String?
  category        BlogCategory
  
  // Relations
  authorId        String?
  author          BlogAuthor? @relation(fields: [authorId], references: [id])
  tags            BlogTag[]

  metaTitle       String?
  metaDescription String?
  keywords        String[]
  published       Boolean  @default(false)
  featured        Boolean  @default(false)
  publishedAt     DateTime?
  viewsCount      Int      @default(0)
  commentsCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  comments        Comment[]

  @@index([slug])
  @@index([category])
  @@index([published])
  @@index([featured])
  @@map("blogs")
}

model BlogAuthor {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  titleAr   String?
  titleEn   String?
  bioAr     String?   @db.Text
  bioEn     String?   @db.Text
