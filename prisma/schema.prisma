// ═══════════════════════════════════════════════════════════════
// 🚗 Cars Management
// ═══════════════════════════════════════════════════════════════

model Car {
  id             String      @id @default(cuid())
  name           String
  nameAr         String
  slug           String      @unique
  description    String      @db.Text
  descriptionAr  String      @db.Text
  brand          String?
  type           String      // e.g. SUV, 4x4, Sedan, VIP Transport
  year           Int?
  pricePerDay    Float
  discount       Float?      @default(0)
  seats          Int         @default(4)
  doors          Int         @default(4)
  transmission   String      @default("Automatic") // Automatic or Manual
  fuelType       String?     // Petrol, Diesel, Hybrid, Electric
  rating         Float       @default(0)
  reviewsCount   Int         @default(0)
  status         HotelStatus @default(ACTIVE)  // Reusing HotelStatus enum (ACTIVE, DRAFT, SUSPENDED)
  featured       Boolean     @default(false)

  coverImage     String
  images         String[]
  videoUrl       String?

  features       String[]
  featuresAr     String[]

  metaTitle      String?
  metaDescription String?
  keywords       String[]

  // Professional Rental Specific
  insurance      String?     @default("Basic") // Basic, Comprehensive, Premium
  insuranceAr    String?     @default("تأمين أساسي")
  mileage        String?     @default("Unlimited") // Unlimited, 200km/day
  mileageAr      String?     @default("غير محدود")
  color          String?
  colorAr        String?
  minAge         Int         @default(21)
  deposit        Float       @default(0) // Security deposit
  luggage        Int         @default(2) // Number of bags

  viewsCount     Int @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings       Booking[]

  @@index([slug])
  @@index([featured])
  @@index([status])
  @@index([pricePerDay])
  @@index([rating])
  @@map("cars")
}

