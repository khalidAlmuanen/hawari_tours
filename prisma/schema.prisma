  threats String[] // Conservation threats
  activitiesEn String?
  activitiesAr String?
  bestTimeEn   String?
  bestTimeAr   String?
  depth        String?
  difficultyEn String?
  difficultyAr String?
  scientificName String?
  categoryEn   String?
  categoryAr   String?
