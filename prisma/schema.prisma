  socials   Json?     // e.g. { twitter: "", linkedin: "" }
  blogs     Blog[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("blog_authors")
}

model BlogTag {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  slug      String   @unique
