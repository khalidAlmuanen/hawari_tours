generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ContactSetting {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_settings")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          UserRole  @default(USER)
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  messages      Message[]
  reviews       Review[]

  @@map("users")
}

model Tour {
  id              String       @id @default(cuid())
  title           String
  titleAr         String
  slug            String       @unique
  description     String
  descriptionAr   String
  price           Float
  discount        Float?       @default(0)
  duration        Int
  maxPeople       Int
  difficulty      Difficulty   @default(MODERATE)
  category        TourCategory
  featured        Boolean      @default(false)
  isActive        Boolean      @default(true)
  coverImage      String
  images          String[]
  videoUrl        String?
  location        String
  locationAr      String
  latitude        Float?
  longitude       Float?
  itinerary       Json?
  includes        String[]
  excludes        String[]
  rating          Float        @default(0)
  reviewsCount    Int          @default(0)
  bookingsCount   Int          @default(0)
  viewsCount      Int          @default(0)
  metaTitle       String?
  metaDescription String?
  keywords        String[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  cardImage       String?
  features        String[]
  featuresAr      String[]
  bookings        Booking[]
  reviews         Review[]
  tourDates       TourDate[]

  @@index([slug])
  @@index([category])
  @@index([featured])
  @@index([bookingsCount])
  @@index([price])
  @@index([rating])
  @@map("tours")
}

model Hotel {
  id                   String          @id @default(cuid())
  name                 String
  nameAr               String
  slug                 String          @unique
  description          String
  descriptionAr        String
  shortDescription     String?
  shortDescriptionAr   String?
  pricePerNight        Float
  discount             Float?          @default(0)
  rating               Float           @default(0)
  reviewsCount         Int             @default(0)
  roomsCount           Int             @default(0)
  status               HotelStatusEnum @default(ACTIVE)
  featured             Boolean         @default(false)
  coverImage           String
  images               String[]
  videoUrl             String?
  location             String
  locationAr           String
  latitude             Float?
  longitude            Float?
  amenities            String[]
  amenitiesAr          String[]
  highlights           String[]
  highlightsAr         String[]
  checkInTime          String?
  checkOutTime         String?
  cancellationPolicy   String?
  cancellationPolicyAr String?
  metaTitle            String?
  metaDescription      String?
  keywords             String[]
  viewsCount           Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  bookings             Booking[]

  @@index([slug])
  @@index([featured])
  @@index([status])
  @@index([pricePerNight])
  @@index([rating])
  @@map("hotels")
}

model HotelsPageSetting {
  id                     String   @id @default(cuid())
  heroImage              String   @default("/img/hero/socotra-3.jpg")
  heroBadgeAr            String   @default("حجز فنادق فاخرة في سقطرى")
  heroBadgeEn            String   @default("Luxury Hotel Booking in Socotra")
  heroTitleAr            String   @default("تجربة إقامة مبهرة بتفاصيل ملكية")
  heroTitleEn            String   @default("A Royal Stay Crafted with Luxury")
  heroSubtitleAr         String   @default("اختر غرفتك المثالية مع عروض حصرية، خدمات خاصة، وتجارب مصممة بعناية لكل رحلة.")
  heroSubtitleEn         String   @default("Choose your perfect suite with exclusive offers, private services, and curated experiences.")
  primaryButtonAr        String   @default("احجز الآن")
  primaryButtonEn        String   @default("Book Now")
  primaryButtonLink      String   @default("/contact")
  secondaryButtonAr      String   @default("استكشف الجولات")
  secondaryButtonEn      String   @default("Explore Tours")
  secondaryButtonLink    String   @default("/tours")
  stats                  Json     @default("[{\"value\": \"28+\", \"labelAr\": \"فنادق فاخرة\", \"labelEn\": \"Luxury Hotels\"}, {\"value\": \"4.8\", \"labelAr\": \"متوسط التقييم\", \"labelEn\": \"Avg Rating\"}, {\"value\": \"24/7\", \"labelAr\": \"خدمة VIP\", \"labelEn\": \"VIP Service\"}]")
  searchTitleAr          String   @default("بحث ذكي عن الفندق")
  searchTitleEn          String   @default("Smart Hotel Search")
  searchButtonAr         String   @default("عرض الخيارات الفاخرة")
  searchButtonEn         String   @default("Show Luxury Options")
  searchHintLeftAr       String   @default("حجز فوري مضمون")
  searchHintLeftEn       String   @default("Instant booking guaranteed")
  searchHintRightAr      String   @default("دعم 24/7")
  searchHintRightEn      String   @default("24/7 Support")
  filtersTitleAr         String   @default("فلترة فاخرة")
  filtersTitleEn         String   @default("Luxury Filters")
  experiences            Json     @default("[{\"icon\": \"✨\", \"descAr\": \"تنسيق حجوزاتك وتنقلاتك بلمسة شخصية\", \"descEn\": \"Personalized concierge for every detail\", \"titleAr\": \"خدمة مضيف خاص 24/7\", \"titleEn\": \"Private host 24/7\"}, {\"icon\": \"🍽️\", \"descAr\": \"قوائم مصممة خصيصا بإطلالة ساحرة\", \"descEn\": \"Custom menus with cinematic views\", \"titleAr\": \"جلسات عشاء على الشاطئ\", \"titleEn\": \"Beachfront dining\"}, {\"icon\": \"🫧\", \"descAr\": \"جلسات استرخاء بمواد طبيعية محلية\", \"descEn\": \"Signature treatments with local essences\", \"titleAr\": \"تجارب سبا صحية\", \"titleEn\": \"Wellness spa rituals\"}]")
  vipTitleAr             String   @default("خدمة حجز VIP عبر فريقنا")
  vipTitleEn             String   @default("VIP Booking Concierge")
  vipDescriptionAr       String   @default("نوفر لك تفاوض على أفضل الأسعار، ترقية الغرف، وتجهيزات استثنائية لرحلتك القادمة.")
  vipDescriptionEn       String   @default("We secure exclusive rates, room upgrades, and bespoke arrangements for your next escape.")
  vipPrimaryButtonAr     String   @default("تواصل مع المستشار")
  vipPrimaryButtonEn     String   @default("Talk to Concierge")
  vipPrimaryButtonLink   String   @default("/contact")
  vipSecondaryButtonAr   String   @default("أضف جولة فاخرة")
  vipSecondaryButtonEn   String   @default("Add a luxury tour")
  vipSecondaryButtonLink String   @default("/tours")
  updatedAt              DateTime @updatedAt

  @@map("hotels_page_settings")
}

model TourDate {
  id             String   @id @default(cuid())
  tourId         String
  startDate      DateTime
  endDate        DateTime
  availableSpots Int
  price          Float
  isActive       Boolean  @default(true)
  tour           Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([startDate])
  @@map("tour_dates")
}

model Booking {
  id              String         @id @default(cuid())
  bookingNumber   String         @unique
  userId          String
  tourId          String?
  startDate       DateTime
  endDate         DateTime
  numberOfPeople  Int
  totalPrice      Float
  paidAmount      Float          @default(0)
  status          BookingStatus  @default(PENDING)
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentMethod   PaymentMethod?
  customerName    String
  customerEmail   String
  customerPhone   String
  specialRequests String?
  notes           String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  bookingType     BookingType    @default(TOUR)
  carId           String?
  hotelId         String?
  numberOfRooms   Int?           @default(1)
  car             Car?           @relation(fields: [carId], references: [id])
  hotel           Hotel?         @relation(fields: [hotelId], references: [id])
  tour            Tour?          @relation(fields: [tourId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
  payments        Payment[]

  @@index([userId])
  @@index([tourId])
  @@index([hotelId])
  @@index([carId])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingNumber])
  @@index([createdAt])
  @@index([totalPrice])
  @@index([customerEmail])
  @@map("bookings")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String
  amount        Float
  method        PaymentMethod
  status        String
  transactionId String?
  notes         String?
  createdAt     DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("payments")
}

model Destination {
  id              String              @id @default(cuid())
  name            String
  nameAr          String
  slug            String              @unique
  description     String
  descriptionAr   String
  image           String?
  coverImage      String?
  gallery         String[]
  latitude        Float?
  longitude       Float?
  region          String?
  viewsCount      Int                 @default(0)
  toursCount      Int                 @default(0)
  featured        Boolean             @default(false)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  activities      String[]            @default([])
  bestTimeToVisit String?
  category        DestinationCategory @default(NATURE)
  highlights      String[]            @default([])
  images          String[]
  unesco          Boolean             @default(false)

  @@index([slug])
  @@index([category])
  @@index([featured])
  @@map("destinations")
}

model News {
  id              String       @id @default(cuid())
  title           String
  titleAr         String
  slug            String       @unique
  excerpt         String
  excerptAr       String
  content         String
  contentAr       String
  coverImage      String
  images          String[]
  category        NewsCategory
  tags            String[]
  featured        Boolean      @default(false)
  breaking        Boolean      @default(false)
  trending        Boolean      @default(false)
  published       Boolean      @default(false)
  publishedAt     DateTime?
  viewsCount      Int          @default(0)
  metaTitle       String?
  metaDescription String?
  authorId        String?
  authorName      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([slug])
  @@index([category])
  @@index([published])
  @@map("news")
}

model GalleryImage {
  id            String          @id @default(cuid())
  title         String?
  titleAr       String?
  description   String?
  descriptionAr String?
  url           String
  thumbnail     String?
  category      GalleryCategory
  tags          String[]
  width         Int?
  height        Int?
  size          Int?
  format        String?
  featured      Boolean         @default(false)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category])
  @@map("gallery_images")
}

model Testimonial {
  id             String   @id @default(cuid())
  customerName   String
  customerNameAr String?
  customerEmail  String?
  customerImage  String?
  content        String
  contentAr      String?
  rating         Int
  tourName       String?
  tourNameAr     String?
  featured       Boolean  @default(false)
  verified       Boolean  @default(false)
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  country        String
  countryAr      String?
  countryCode    String
  customerPhone  String?
  date           DateTime @default(now())
  hasVideo       Boolean  @default(false)
  videoUrl       String?

  @@index([published])
  @@index([featured])
  @@index([country])
  @@map("testimonials")
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  tourId       String
  rating       Int
  title        String?
  comment      String
  helpfulCount Int      @default(0)
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tour         Tour     @relation(fields: [tourId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tourId])
  @@index([approved])
  @@map("reviews")
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  userId    String?
  status    MessageStatus @default(UNREAD)
  repliedAt DateTime?
  reply     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
  @@map("messages")
}

model Analytics {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  pageViews      Int      @default(0)
  uniqueVisitors Int      @default(0)
  bounceRate     Float?
  avgSessionTime Int?
  bookings       Int      @default(0)
  revenue        Float    @default(0)
  directTraffic  Int      @default(0)
  organicSearch  Int      @default(0)
  socialMedia    Int      @default(0)
  referral       Int      @default(0)
  desktop        Int      @default(0)
  mobile         Int      @default(0)
  tablet         Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([date])
  @@map("analytics")
}

model GalleryVideo {
  id            String          @id @default(cuid())
  title         String
  titleAr       String
  description   String?
  descriptionAr String?
  videoUrl      String
  thumbnail     String?
  duration      String?
  category      GalleryCategory
  featured      Boolean         @default(false)
  isActive      Boolean         @default(true)
  viewCount     Int             @default(0)
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category])
  @@index([featured])
  @@index([order])
  @@map("gallery_videos")
}

model VirtualTour {
  id            String   @id @default(cuid())
  title         String
  titleAr       String
  description   String?
  descriptionAr String?
  location      String
  locationAr    String
  tourUrl       String
  icon          String   @default("🌐")
  gradient      String   @default("from-blue-500 to-cyan-600")
  featured      Boolean  @default(false)
  isActive      Boolean  @default(true)
  viewCount     Int      @default(0)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([featured])
  @@index([order])
  @@map("virtual_tours")
}

model InstagramPost {
  id        String   @id @default(cuid())
  imageUrl  String
  postUrl   String?
  likes     Int      @default(0)
  comments  Int      @default(0)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("instagram_posts")
}

model GallerySetting {
  id                     String   @id @default(cuid())
  heroTitle              String   @default("Explore Socotra")
  heroTitleAr            String   @default("استكشف سقطرى")
  heroSubtitle           String?
  heroSubtitleAr         String?
  heroImage              String?
  heroDescription        String?
  heroDescriptionAr      String?
  instagramUsername      String   @default("@HawariTours")
  instagramUrl           String   @default("https://instagram.com/hawaritours")
  instagramTitle         String   @default("Follow us on Instagram")
  instagramTitleAr       String   @default("تابعنا على إنستغرام")
  instagramDescription   String?
  instagramDescriptionAr String?
  downloadTitle          String   @default("Want High-Resolution Copy?")
  downloadTitleAr        String   @default("هل تريد نسخة عالية الجودة؟")
  downloadDescription    String?
  downloadDescriptionAr  String?
  downloadEnabled        Boolean  @default(true)
  ctaTitle               String   @default("Liked the Photos? Visit Socotra Yourself!")
  ctaTitleAr             String   @default("هل أعجبتك الصور؟ زر سقطرى بنفسك!")
  ctaDescription         String?
  ctaDescriptionAr       String?
  ctaButtonText          String   @default("Browse Tours")
  ctaButtonTextAr        String   @default("تصفح الرحلات")
  statsEnabled           Boolean  @default(true)
  virtualToursCount      String   @default("10+")
  highQualityLabel       String   @default("4K")
  updatedAt              DateTime @updatedAt

  @@map("gallery_settings")
}

model QuickTip {
  id            String   @id @default(cuid())
  icon          String
  title         String
  titleAr       String
  description   String
  descriptionAr String
  gradient      String
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
  @@map("quick_tips")
}

model VisaRequirement {
  id        String   @id @default(cuid())
  itemAr    String
  itemEn    String
  icon      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("visa_requirements")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  bookingId String?
  reviewId  String?
  messageId String?

  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model FlightRoute {
  id          String   @id @default(cuid())
  fromAr      String
  fromEn      String
  airline     String
  duration    String
  frequencyAr String
  frequencyEn String
  price       String
  icon        String
  gradient    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@map("flight_routes")
}

model LocalTransport {
  id            String   @id @default(cuid())
  typeAr        String
  typeEn        String
  descriptionAr String?
  descriptionEn String?
  priceAr       String
  priceEn       String
  icon          String
  gradient      String
  features      String[]
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
  @@map("local_transport")
}

model AccommodationType {
  id            String   @id @default(cuid())
  typeAr        String
  typeEn        String
  descriptionAr String?
  descriptionEn String?
  priceAr       String
  priceEn       String
  icon          String
  rating        Int      @default(3)
  gradient      String
  features      String[]
  examples      String[]
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
  @@map("accommodation_types")
}

model SafetyCategory {
  id         String      @id @default(cuid())
  categoryAr String
  categoryEn String
  icon       String
  order      Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tips       SafetyTip[]

  @@index([order])
  @@map("safety_categories")
}

model SafetyTip {
  id          String         @id @default(cuid())
  categoryId  String
  tipAr       String
  tipEn       String
  isImportant Boolean        @default(false)
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  category    SafetyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([order])
  @@map("safety_tips")
}

model TimelineEvent {
  id            String   @id @default(cuid())
  year          String
  yearEn        String?
  era           String
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  icon          String
  color         String
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([era])
  @@index([order])
  @@map("timeline_events")
}

model ArchaeologicalSite {
  id             String   @id @default(cuid())
  nameEn         String
  nameAr         String
  periodEn       String   @default("Ancient Period")
  periodAr       String   @default("فترة قديمة")
  descriptionEn  String
  descriptionAr  String
  significanceEn String?
  significanceAr String?
  locationEn     String?
  locationAr     String?
  accessEn       String?
  accessAr       String?
  gradient       String   @default("from-amber-500 to-orange-600")
  imageUrl       String?
  featured       Boolean  @default(false)
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([featured])
  @@index([order])
  @@map("archaeological_sites")
}

model HistoricalSection {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleAr   String
  contentEn String
  contentAr String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("historical_sections")
}

model HistoryPageSetting {
  id             String   @id @default(cuid())
  heroTitleEn    String   @default("History of Socotra")
  heroTitleAr    String   @default("تاريخ سقطرى")
  heroSubtitleEn String?
  heroSubtitleAr String?
  heroImage      String?
  ctaTitleEn     String   @default("Discover Socotra History Yourself")
  ctaTitleAr     String   @default("اكتشف تاريخ سقطرى بنفسك")
  ctaTextEn      String?
  ctaTextAr      String?
  ctaImage       String?
  metaTitleEn    String?
  metaTitleAr    String?
  metaDescEn     String?
  metaDescAr     String?
  extraContent   Json?    @default("{}")
  updatedAt      DateTime @updatedAt

  @@map("history_page_settings")
}

model EmergencyContact {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  number    String
  icon      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("emergency_contacts")
}

model PackingCategory {
  id         String   @id @default(cuid())
  categoryAr String
  categoryEn String
  icon       String
  items      String[]
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
  @@map("packing_categories")
}

model TravelGuideSetting {
  id                   String   @id @default(cuid())
  heroTitleAr          String   @default("دليل السفر")
  heroTitleEn          String   @default("Travel Guide")
  heroSubtitleAr       String?
  heroSubtitleEn       String?
  visaTitleAr          String   @default("التأشيرات ومتطلبات الدخول")
  visaTitleEn          String   @default("Visa & Entry Requirements")
  transportTitleAr     String   @default("النقل والمواصلات")
  transportTitleEn     String   @default("Transportation")
  accommodationTitleAr String   @default("خيارات الإقامة")
  accommodationTitleEn String   @default("Accommodation Options")
  bestTimeTitleAr      String   @default("أفضل وقت للزيارة")
  bestTimeTitleEn      String   @default("Best Time to Visit")
  peakSeasonAr         String   @default("أكتوبر - مارس")
  peakSeasonEn         String   @default("October - March")
  offSeasonAr          String   @default("يونيو - سبتمبر")
  offSeasonEn          String   @default("June - September")
  safetyTitleAr        String   @default("نصائح السلامة")
