// ═══════════════════════════════════════════════════════════════
// 🗄️ DATABASE SCHEMA - Prisma
// قاعدة بيانات كاملة لمشروع Hawarl Tours
// ═══════════════════════════════════════════════════════════════

// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════
// 📞 Contact Page Settings
// ═══════════════════════════════════════════════════════════════
model ContactSetting {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_settings")
}


// ═══════════════════════════════════════════════════════════════
// 👤 User Management
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          UserRole  @default(USER)
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  bookings Booking[]
  reviews  Review[]
  messages Message[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

// ═══════════════════════════════════════════════════════════════
// ✈️ Tours Management
// ═══════════════════════════════════════════════════════════════

model Tour {
  id            String       @id @default(cuid())
  title         String
  titleAr       String
  slug          String       @unique
  description   String       @db.Text
  descriptionAr String       @db.Text
  price         Float
  discount      Float?       @default(0)
  duration      Int // في الأيام
  maxPeople     Int
  difficulty    Difficulty   @default(MODERATE)
  category      TourCategory
  featured      Boolean      @default(false)
  isActive      Boolean      @default(true)

  // Media
  coverImage String
  cardImage  String? // صورة مخصصة للبطاقة (اختياري)
  images     String[]
  videoUrl   String?

  // Location
  location   String
  locationAr String
  latitude   Float?
  longitude  Float?

  // Itinerary
  itinerary Json? // تفاصيل البرنامج اليومي

  // Includes/Excludes
  includes String[]
  excludes String[]
  
  // Features (Available Amenities/Highlights)
  features   String[]
  featuresAr String[]

  // Stats
  rating        Float @default(0)
  reviewsCount  Int   @default(0)
  bookingsCount Int   @default(0)
  viewsCount    Int   @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings  Booking[]
  reviews   Review[]
  tourDates TourDate[]

  @@index([slug])
  @@index([category])
  @@index([featured])
  @@index([bookingsCount])
  @@index([price])
  @@index([rating])
  @@map("tours")
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
  DIFFICULT
}

enum TourCategory {
  ADVENTURE
  CULTURAL
  NATURE
  BEACH
  WILDLIFE
  HERITAGE
}

enum HotelStatus {
  ACTIVE
  DRAFT
  SUSPENDED
}

enum BookingType {
  TOUR
  HOTEL
  CAR
}

model Hotel {
  id                 String      @id @default(cuid())
  name               String
  nameAr             String
  slug               String      @unique
  description        String      @db.Text
  descriptionAr      String      @db.Text
  shortDescription   String?     @db.Text
  shortDescriptionAr String?     @db.Text
  pricePerNight      Float
  discount           Float?      @default(0)
  rating             Float       @default(0)
  reviewsCount       Int         @default(0)
  roomsCount         Int         @default(0)
  status             HotelStatus @default(ACTIVE)
  featured           Boolean     @default(false)

  coverImage String
  images     String[]
  videoUrl   String?

  location   String
  locationAr String
  latitude   Float?
  longitude  Float?

  amenities   String[]
  amenitiesAr String[]
  highlights  String[]
  highlightsAr String[]

  checkInTime          String?
  checkOutTime         String?
  cancellationPolicy   String?   @db.Text
  cancellationPolicyAr String?   @db.Text

  metaTitle       String?
  metaDescription String?
  keywords        String[]

  viewsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([slug])
  @@index([featured])
  @@index([status])
  @@index([pricePerNight])
  @@index([rating])
  @@map("hotels")
}

model HotelsPageSetting {
  id String @id @default(cuid())

  heroImage        String @default("/img/hero/socotra-3.jpg")
  heroBadgeAr      String @default("حجز فنادق فاخرة في سقطرى")
  heroBadgeEn      String @default("Luxury Hotel Booking in Socotra")
  heroTitleAr      String @default("تجربة إقامة مبهرة بتفاصيل ملكية")
  heroTitleEn      String @default("A Royal Stay Crafted with Luxury")
  heroSubtitleAr   String @default("اختر غرفتك المثالية مع عروض حصرية، خدمات خاصة، وتجارب مصممة بعناية لكل رحلة.") @db.Text
  heroSubtitleEn   String @default("Choose your perfect suite with exclusive offers, private services, and curated experiences.") @db.Text
  primaryButtonAr  String @default("احجز الآن")
  primaryButtonEn  String @default("Book Now")
  primaryButtonLink String @default("/contact")
  secondaryButtonAr String @default("استكشف الجولات")
  secondaryButtonEn String @default("Explore Tours")
  secondaryButtonLink String @default("/tours")

  stats Json @default("[{\"value\":\"28+\",\"labelAr\":\"فنادق فاخرة\",\"labelEn\":\"Luxury Hotels\"},{\"value\":\"4.8\",\"labelAr\":\"متوسط التقييم\",\"labelEn\":\"Avg Rating\"},{\"value\":\"24/7\",\"labelAr\":\"خدمة VIP\",\"labelEn\":\"VIP Service\"}]")

  searchTitleAr     String @default("بحث ذكي عن الفندق")
  searchTitleEn     String @default("Smart Hotel Search")
  searchButtonAr    String @default("عرض الخيارات الفاخرة")
  searchButtonEn    String @default("Show Luxury Options")
  searchHintLeftAr  String @default("حجز فوري مضمون")
  searchHintLeftEn  String @default("Instant booking guaranteed")
  searchHintRightAr String @default("دعم 24/7")
  searchHintRightEn String @default("24/7 Support")

  filtersTitleAr String @default("فلترة فاخرة")
  filtersTitleEn String @default("Luxury Filters")

  experiences Json @default("[{\"titleAr\":\"خدمة مضيف خاص 24/7\",\"titleEn\":\"Private host 24/7\",\"descAr\":\"تنسيق حجوزاتك وتنقلاتك بلمسة شخصية\",\"descEn\":\"Personalized concierge for every detail\",\"icon\":\"✨\"},{\"titleAr\":\"جلسات عشاء على الشاطئ\",\"titleEn\":\"Beachfront dining\",\"descAr\":\"قوائم مصممة خصيصا بإطلالة ساحرة\",\"descEn\":\"Custom menus with cinematic views\",\"icon\":\"🍽️\"},{\"titleAr\":\"تجارب سبا صحية\",\"titleEn\":\"Wellness spa rituals\",\"descAr\":\"جلسات استرخاء بمواد طبيعية محلية\",\"descEn\":\"Signature treatments with local essences\",\"icon\":\"🫧\"}]")

  vipTitleAr String @default("خدمة حجز VIP عبر فريقنا")
  vipTitleEn String @default("VIP Booking Concierge")
  vipDescriptionAr String @default("نوفر لك تفاوض على أفضل الأسعار، ترقية الغرف، وتجهيزات استثنائية لرحلتك القادمة.") @db.Text
  vipDescriptionEn String @default("We secure exclusive rates, room upgrades, and bespoke arrangements for your next escape.") @db.Text
  vipPrimaryButtonAr String @default("تواصل مع المستشار")
  vipPrimaryButtonEn String @default("Talk to Concierge")
  vipPrimaryButtonLink String @default("/contact")
  vipSecondaryButtonAr String @default("أضف جولة فاخرة")
  vipSecondaryButtonEn String @default("Add a luxury tour")
  vipSecondaryButtonLink String @default("/tours")

  updatedAt DateTime @updatedAt

  @@map("hotels_page_settings")
}

model TourDate {
  id             String   @id @default(cuid())
  tourId         String
  startDate      DateTime
  endDate        DateTime
  availableSpots Int
  price          Float
  isActive       Boolean  @default(true)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([startDate])
  @@map("tour_dates")
}

// ═══════════════════════════════════════════════════════════════
// 📅 Bookings Management
// ═══════════════════════════════════════════════════════════════

model Booking {
  id            String @id @default(cuid())
  bookingNumber String @unique

  // User & Tour / Hotel / Car
  userId String
  tourId String?
  hotelId String?
  carId   String?
  bookingType BookingType @default(TOUR)

  // Details
  startDate      DateTime
  endDate        DateTime
  numberOfPeople Int
  numberOfRooms  Int?    @default(1)
  totalPrice     Float
  paidAmount     Float    @default(0)

  // Status
  status        BookingStatus  @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?

  // Contact Info
  customerName  String
  customerEmail String
  customerPhone String

  // Special Requests
  specialRequests String? @db.Text
  notes           String? @db.Text

  // Timestamps
  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id])
  tour     Tour?     @relation(fields: [tourId], references: [id])
  hotel    Hotel?    @relation(fields: [hotelId], references: [id])
  car      Car?      @relation(fields: [carId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([tourId])
  @@index([hotelId])
  @@index([carId])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingNumber])
  @@index([createdAt])
  @@index([totalPrice])
  @@index([customerEmail])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CASH
  PAYPAL
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String
  amount        Float
  method        PaymentMethod
  status        String
  transactionId String?
  notes         String?
  createdAt     DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("payments")
}

// ═══════════════════════════════════════════════════════════════
// 🏛️ Destinations Management
// ═══════════════════════════════════════════════════════════════

model Destination {
  id            String @id @default(cuid())
  name          String
  nameAr        String
  slug          String @unique
  description   String @db.Text
  descriptionAr String @db.Text

  // Media (keep old fields for compatibility)
  image      String? // Legacy field
  coverImage String?
  gallery    String[] // Legacy field
  images     String[]

  // Location
  latitude  Float?
  longitude Float?
  region    String? // Legacy field

  // Details
  category        DestinationCategory @default(NATURE)
  highlights      String[]            @default([])
  activities      String[]            @default([])
  bestTimeToVisit String?

  // Special Designations
  unesco Boolean @default(false)

  // Stats
  viewsCount Int @default(0)
  toursCount Int @default(0)

  // Status
  featured Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([featured])
  @@map("destinations")
}

enum DestinationCategory {
  NATURE
  HERITAGE
  BEACH
  MOUNTAIN
  ARCHAEOLOGICAL
  WILDLIFE
  CULTURAL
  URBAN
  ADVENTURE
}

// ═══════════════════════════════════════════════════════════════
// 📰 News Management
// ═══════════════════════════════════════════════════════════════

model News {
  id        String @id @default(cuid())
  title     String
  titleAr   String
  slug      String @unique
  excerpt   String
  excerptAr String
  content   String @db.Text
  contentAr String @db.Text

  // Media
  coverImage String
  images     String[]

  // Categorization
  category NewsCategory
  tags     String[]

  // Publishing
  featured    Boolean   @default(false)
  breaking    Boolean   @default(false)
  trending    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?

  // Stats
  viewsCount Int @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Author
  authorId   String?
  authorName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([published])
  @@map("news")
}

enum NewsCategory {
  TOURISM
  ENVIRONMENT
  WEATHER
  UNESCO
  CULTURE
  EVENTS
}

// ═══════════════════════════════════════════════════════════════
// 🖼️ Gallery Management
// ═══════════════════════════════════════════════════════════════

model GalleryImage {
  id            String  @id @default(cuid())
  title         String?
  titleAr       String?
  description   String?
  descriptionAr String?

  // Media
  url       String
  thumbnail String?

  // Categorization
  category GalleryCategory
  tags     String[]

  // Metadata
  width  Int?
  height Int?
  size   Int?
  format String?

  featured Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("gallery_images")
}

enum GalleryCategory {
  DESTINATIONS
  TOURS
  NATURE
  CULTURE
  WILDLIFE
  PEOPLE
}

// ═══════════════════════════════════════════════════════════════
// 💬 Testimonials/Reviews Management
// ═══════════════════════════════════════════════════════════════

model Testimonial {
  id             String  @id @default(cuid())
  customerName   String
  customerNameAr String?
  customerEmail  String?
  customerPhone  String?
  customerImage  String?
  country        String // Country name in English
  countryAr      String? // Country name in Arabic
  countryCode    String // ISO country code (e.g., "US", "SA")

  content   String  @db.Text
  contentAr String? @db.Text

  rating     Int // 1-5
  tourName   String?
  tourNameAr String?

  // Video Support
  hasVideo Boolean @default(false)
  videoUrl String? // YouTube or other video platform URL

  // Dates
  date DateTime @default(now()) // When the tour was taken

  featured  Boolean @default(false)
  verified  Boolean @default(false)
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@index([country])
  @@map("testimonials")
}

model Review {
  id     String @id @default(cuid())
  userId String
  tourId String

  rating  Int // 1-5
  title   String?
  comment String  @db.Text

  // Helpful count
  helpfulCount Int @default(0)

  // Moderation
  approved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  tour Tour @relation(fields: [tourId], references: [id])

  @@index([userId])
  @@index([tourId])
  @@index([approved])
  @@map("reviews")
}

// ═══════════════════════════════════════════════════════════════
// ✉️ Messages/Contact Management
// ═══════════════════════════════════════════════════════════════

model Message {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String
  message String  @db.Text

  // Optional user link
  userId String?

  // Status
  status    MessageStatus @default(UNREAD)
  repliedAt DateTime?
  reply     String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
  @@map("messages")
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

// ═══════════════════════════════════════════════════════════════
// 📊 Analytics & Stats
// ═══════════════════════════════════════════════════════════════

model Analytics {
  id   String   @id @default(cuid())
  date DateTime @db.Date

  // Traffic
  pageViews      Int    @default(0)
  uniqueVisitors Int    @default(0)
  bounceRate     Float?
  avgSessionTime Int? // in seconds

  // Conversions
  bookings Int   @default(0)
  revenue  Float @default(0)

  // Sources
  directTraffic Int @default(0)
  organicSearch Int @default(0)
  socialMedia   Int @default(0)
  referral      Int @default(0)

  // Devices
  desktop Int @default(0)
  mobile  Int @default(0)
  tablet  Int @default(0)

  createdAt DateTime @default(now())

  @@unique([date])
  @@index([date])
  @@map("analytics")
}

// ═══════════════════════════════════════════════════════════════
// 🎬 Gallery Video Management (معرض الفيديوهات)
// ═══════════════════════════════════════════════════════════════

model GalleryVideo {
  id            String          @id @default(cuid())
  title         String
  titleAr       String
  description   String?         @db.Text
  descriptionAr String?         @db.Text
  videoUrl      String // YouTube/Vimeo URL
  thumbnail     String? // Custom thumbnail URL
  duration      String? // Format: "5:30"
  category      GalleryCategory
  featured      Boolean         @default(false)
  isActive      Boolean         @default(true)
  viewCount     Int             @default(0)
  order         Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([order])
  @@map("gallery_videos")
}

// ═══════════════════════════════════════════════════════════════
// 🌐 Virtual Tours 360° Management (جولات افتراضية)
// ═══════════════════════════════════════════════════════════════

model VirtualTour {
  id            String  @id @default(cuid())
  title         String
  titleAr       String
  description   String? @db.Text
  descriptionAr String? @db.Text
  location      String
  locationAr    String
  tourUrl       String // URL للجولة الافتراضية
  icon          String  @default("🌐") // Emoji icon
  gradient      String  @default("from-blue-500 to-cyan-600")
  featured      Boolean @default(false)
  isActive      Boolean @default(true)
  viewCount     Int     @default(0)
  order         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([featured])
  @@index([order])
  @@map("virtual_tours")
}

// ═══════════════════════════════════════════════════════════════
// 📱 Instagram Posts (منشورات إنستغرام)
// ═══════════════════════════════════════════════════════════════

model InstagramPost {
  id       String  @id @default(cuid())
  imageUrl String
  postUrl  String? // رابط المنشور على Instagram
  likes    Int     @default(0)
  comments Int     @default(0)
  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("instagram_posts")
}

// ═══════════════════════════════════════════════════════════════
// 📸 Gallery Page Settings (إعدادات صفحة المعرض)
// ═══════════════════════════════════════════════════════════════

model GallerySetting {
  id String @id @default(cuid())

  // Hero Section
  heroTitle         String  @default("Explore Socotra")
  heroTitleAr       String  @default("استكشف سقطرى")
  heroSubtitle      String? @db.Text
  heroSubtitleAr    String? @db.Text
  heroImage         String?
  heroDescription   String? @db.Text
  heroDescriptionAr String? @db.Text

  // Instagram Settings
  instagramUsername      String  @default("@HawariTours")
  instagramUrl           String  @default("https://instagram.com/hawaritours")
  instagramTitle         String  @default("Follow us on Instagram")
  instagramTitleAr       String  @default("تابعنا على إنستغرام")
  instagramDescription   String?
  instagramDescriptionAr String?

  // Download Section
  downloadTitle         String  @default("Want High-Resolution Copy?")
  downloadTitleAr       String  @default("هل تريد نسخة عالية الجودة؟")
  downloadDescription   String? @db.Text
  downloadDescriptionAr String? @db.Text
  downloadEnabled       Boolean @default(true)

  // CTA Section
  ctaTitle         String  @default("Liked the Photos? Visit Socotra Yourself!")
  ctaTitleAr       String  @default("هل أعجبتك الصور؟ زر سقطرى بنفسك!")
  ctaDescription   String? @db.Text
  ctaDescriptionAr String? @db.Text
  ctaButtonText    String  @default("Browse Tours")
  ctaButtonTextAr  String  @default("تصفح الرحلات")

  // Stats (can be auto-calculated or manual)
  statsEnabled      Boolean @default(true)
  virtualToursCount String  @default("10+")
  highQualityLabel  String  @default("4K")

  updatedAt DateTime @updatedAt

  @@map("gallery_settings")
}

// ═══════════════════════════════════════════════════════════════
// 🧳 Travel Guide - Complete Management System
// نظام إدارة دليل السفر الشامل
// ═══════════════════════════════════════════════════════════════

// 1. Quick Tips (النصائح السريعة)
model QuickTip {
  id            String  @id @default(cuid())
  icon          String // Emoji
  title         String
  titleAr       String
  description   String
  descriptionAr String
  gradient      String // Tailwind gradient classes
  order         Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("quick_tips")
}

// 2. Visa Information (معلومات التأشيرة)
model VisaRequirement {
  id       String  @id @default(cuid())
  itemAr   String
  itemEn   String
  icon     String // Emoji
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("visa_requirements")
}

// ═══════════════════════════════════════════════════════════════
// 🔔 Notifications Management
// ═══════════════════════════════════════════════════════════════

model Notification {
  id        String   @id @default(cuid())
  type      String   // BOOKING, REVIEW, MESSAGE, SYSTEM
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Optional: Link to specific resources
  bookingId String?
  reviewId  String?
  messageId String?

  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// 3. Flight Routes (خطوط الطيران)
model FlightRoute {
  id          String  @id @default(cuid())
  fromAr      String
  fromEn      String
  airline     String
  duration    String
  frequencyAr String
  frequencyEn String
  price       String
  icon        String // Emoji (country flag)
  gradient    String // Tailwind gradient
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("flight_routes")
}

// 4. Local Transportation (النقل المحلي)
model LocalTransport {
