model BlogToBlogTag {
  A         String
  B         String
  blogs     Blog    @relation(fields: [A], references: [id], onDelete: Cascade)
  blog_tags BlogTag @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_BlogToBlogTag_AB_pkey")
  @@index([B], map: "_BlogToBlogTag_B_index")
  @@map("_BlogToBlogTag")
}

