model ReportCategory {
  id       String @id @default(cuid())
  slug     String @unique
  nameEn   String
  nameAr   String
  icon     String @default("📄")
  gradient String @default("from-gray-500 to-gray-700")
  isActive Boolean @default(true)
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  @@index([order])
  @@index([isActive])
  @@map("report_categories")
}

model Report {
  id          String @id @default(cuid())
  categoryId  String
  titleEn     String
  titleAr     String
  descriptionEn String @db.Text
  descriptionAr String @db.Text
  year        Int
  pages       Int
  languageEn  String
  languageAr  String
  fileSize    String
  downloadUrl String
  featured    Boolean @default(false)
  topics      String[]
  isActive    Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ReportCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([featured])
  @@index([order])
  @@index([isActive])
  @@map("reports")
}

