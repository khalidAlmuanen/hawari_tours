  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_tags")
}

enum BlogCategory {
  CULTURE
  NATURE
  TRAVEL
  STORIES
}

model Comment {
  id      String  @id @default(cuid())
  blogId  String
  name    String
  email   String
  website String?
  content String  @db.Text

  // Moderation
  approved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([approved])
  @@map("comments")
}

