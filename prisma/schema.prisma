model UniqueFeature {
  id            String      @id @default(cuid())
  type          FeatureType
  nameEn        String
  nameAr        String
  descriptionEn String      @db.Text
  descriptionAr String      @db.Text
  images        String[] // Array of image URLs

  // Additional Details
