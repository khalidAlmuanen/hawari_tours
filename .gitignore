# ═══════════════════════════════════════════════════════════════
# Hawari Tours - .gitignore (Professional)
# ═══════════════════════════════════════════════════════════════

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Environment variables (NEVER commit these)
.env
.env.local
.env.*.local
.env.production
.env.development

# Uploaded files (stored in Supabase, not in git)
public/uploads/

# Debug / test scripts (not needed in production)
test-*.js
test-*.mjs
verify_*.js
vercel-debug.js
vercel-troubleshoot.js
vercel-update-trigger.js
seed-*.js
seed-*.mjs
start-clean.ps1
scripts/

# Markdown content files (admin-generated)
reports-*.md
testimonials-content.md
unique-features-content.md
restore_content_guide_ar.md
reports_content_examples.md

# Arabic image folder
"مصور معدلة/"
مصور\ معدلة/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# OS / Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Prisma local dev database
prisma/dev.db
prisma/dev.db-journal

# Generated Prisma client (generated at build time by Vercel)
/generated/prisma

# TypeScript
*.tsbuildinfo
next-env.d.ts
